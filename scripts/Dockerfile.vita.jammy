FROM ubuntu:jammy

# Install basic dependencies
RUN apt-get update && \
    apt-get install -y \
    git \
    cmake \
    ninja-build \
    pkg-config \
    build-essential \
    curl \
    wget \
    python3 \
    python3-pip \
    python3-protobuf \
    libssl-dev \
    libopus-dev \
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libjson-c-dev \
    libminiupnpc-dev \
    libspeexdsp-dev \
    zlib1g-dev \
    ca-certificates \
    sudo \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Install Vita SDK
ENV VITASDK=/usr/local/vitasdk
ENV PATH=$VITASDK/bin:$PATH

RUN git clone https://github.com/vitasdk/vdpm && \
    cd vdpm && \
    ./bootstrap-vitasdk.sh && \
    ./install-all.sh && \
    cd .. && \
    rm -rf vdpm

# Set up environment
WORKDIR /build

# Default command
CMD ["/bin/bash"]
